<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Stylesheet.uss?fileID=7433441132597879392&amp;guid=4e2af57ad7ccf3c4cadfcde4ff2191c2&amp;type=3#Stylesheet"/>
    <ui:VisualElement name="Inventory" style="flex-grow: 1; cursor: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-6527069497977903076&amp;guid=a6ce1382f4cdb934b9851f36f022b582&amp;type=3#check-dash&quot;);">
        <ui:VisualElement name="inventory-root" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.745);">
            <ui:VisualElement name="items-container" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement class="inv-slot-item" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.502);"/>
                <ui:VisualElement class="inv-slot-item" style="flex-grow: 1;"/>
                <ui:VisualElement class="inv-slot-item" style="flex-grow: 1;"/>
                <ui:VisualElement class="inv-slot-item" style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="items-armour" style="flex-grow: 1;">
                <ui:VisualElement name="slot-hat" class="inv-slot-armour" style="flex-grow: 1; -unity-background-image-tint-color: rgba(255, 255, 255, 0.502); background-image: url(&quot;project://database/Assets/Sprites/Inventory/hat_icon.png?fileID=2800000&amp;guid=de6ba9c9e7ded914f84f0f0a5262458d&amp;type=3#hat_icon&quot;); -unity-background-scale-mode: scale-to-fit; background-position-y: center; background-position-x: center; cursor: initial;"/>
                <ui:VisualElement name="slot-chest" class="inv-slot-armour" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Inventory/chest_icon.png?fileID=2800000&amp;guid=437aaa273ecf76d4ca38f7e036923b9f&amp;type=3#chest_icon&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.502); background-position-y: center;"/>
                <ui:VisualElement name="slot-ring" class="inv-slot-armour" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Inventory/ring_icon.png?fileID=2800000&amp;guid=bd37c56ca0c9a9a4dbce0d23146ec06b&amp;type=3#ring_icon&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.502);"/>
                <ui:VisualElement name="slot-boots" class="inv-slot-armour" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Sprites/Inventory/boots_icon.png?fileID=2800000&amp;guid=927ddad869b6b7b4587587edc3e754ec&amp;type=3#boots_icon&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.502);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
